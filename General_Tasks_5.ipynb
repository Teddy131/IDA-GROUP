     ]
    }
   ],
   "source": [
    "#reading the csv-file\n",
    "data = pd.read_csv('data\\Fahrzeug\\Fahrzeuge_OEM1_Typ11_Fehleranalyse.csv')\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "d573f618",
   "metadata": {},
   "outputs": [],
   "source": [
    "#defining feature and target vektor\n",
    "\n",
    "X = data[['days', 'fuel', 'engine']]\n",
    "\n",
    "y = data['Fehlerhaft_Fahrleistung']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "bed4878e",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Train-Test-Split for evaualtion\n",
    "\n",
    "x_train, x_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b32ca6e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "#perpairing the data for training\n",
    "\n",
    "# the engine colum has 3 vlaues: small, medium and large. the computer cannot work with those, so we need to change them to numbers via onehot encoding\n",
    "\n",
    "encoder = OneHotEncoder(sparse_output=False, drop='first')\n",
    "\n",
    "encoder.fit(x_train[['engine']])\n",
    "#the train and the testvektor have now encoded values\n",
    "\n",
    "\n",
    "encoded_engine_train = encoder.transform(x_train[['engine']])\n",
    "encoded_engine_test = encoder.transform(x_test[['engine']])\n",
    "# the new vektors must be combined the other features\n",
    "\n",
    "X_train = np.column_stack([x_train['days'].to_numpy(), \n",
    "                   x_train['fuel'].to_numpy(), encoded_engine_train])\n",
    "\n",
    "X_test = np.column_stack([x_test['days'].to_numpy(), \n",
    "                   x_test['fuel'].to_numpy(), encoded_engine_test])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a69ee29",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Model\n",
    "model = LinearRegression()\n",
    "model.fit(X=X_train, y=y_train)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f5af195c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#generalization\n",
    "# the model needs a cross validation, so it can perform good on other unseen data\n",
    "scores = cross_val_score(model, X_train, y_train, cv=5, scoring='r2')\n",
    "#the result of the cross validation ist printed\n",
    "print(\"%0.5f mean with a standard deviation of %0.6f\" % (scores.mean(), scores.std()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6154691b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#result\n",
    "#r2score\n",
    "# the evalutate the modell, we test it with the splitted data and print the results based on the r^2 score\n",
    "y_pred = model.predict(X_test)\n",
    "print(f' r^2 score: {r2_score(y_test, y_pred)}')\n",
    "\n"
   ]
  }
