import nbformat
import shutil
import os

notebooks = [
    "General_Tasks_1.ipynb",
    "General_Tasks_2.ipynb",
    "General_Tasks_3.ipynb",
    "General_Tasks_4.ipynb",
    "General_Tasks_5.ipynb",
    "General_Tasks_6.ipynb"
]

# Merge
merged = nbformat.v4.new_notebook()
title = nbformat.v4.new_markdown_cell("# General Tasks - Group 14\n\nSoSe 2026 - Introduction to Data Analytics")
merged.cells.append(title)

for nb_file in notebooks:
    nb = nbformat.read(nb_file, as_version=4)
    merged.cells.extend(nb.cells)

nbformat.write(merged, "SoSe26_General_Tasks_Group_14.ipynb")

# Move originals to old_code
os.makedirs("old_code", exist_ok=True)
for nb_file in notebooks:
    shutil.move(nb_file, os.path.join("old_code", nb_file))

print("Done")